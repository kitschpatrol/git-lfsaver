/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "git-lfs-cf",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-30",
	"observability": {
		"enabled": true,
	},
	"preview_urls": false,
	"dev": {
		"local_protocol": "https",
	},
	"routes": [
		{
			"pattern": "lfs.kitschpatrol.com",
			"custom_domain": true,
		},
	],
	"tsconfig": "tsconfig.build.json",
	/**
	 * Values here keep their JSON types at runtime.
	 * R2 credentials are uploaded as string secrets from .env (see .template.env)
	 */
	"vars": {
		/* Comma-separated GitHub owners (users or orgs) whose repos may use this
		 * server. Empty rejects everyone. Not consulted for self-issued repos. */
		"GITHUB_ALLOWED_OWNERS": "kitschpatrol",
		/* Some clients might not set headers correctly... */
		"ENFORCE_MIME": true,
		/* Pre-signed URL expiry in seconds */
		"EXPIRY": 3600,
		/* Maximum file size in bytes, storage-dependent
		 * See https://developers.cloudflare.com/r2/platform/limits/
		 */
		"MAX_FILE_SIZE": 4995000000,
		/* Base64url Ed25519 public key used to verify self-issued tokens for
		 * repos that aren't on GitHub. Generate a key pair with
		 * `pnpm run token generate-key` and paste the printed value here.
		 * Empty disables self-issued tokens. */
		"SELF_ISSUED_TOKEN_PUBLIC_KEY": "",
	},
}
