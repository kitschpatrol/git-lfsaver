# Generated into .env by `pnpm run init` (op inject)
# Uploaded as Worker secrets on `pnpm run deploy` via `wrangler deploy --secrets-file .env`

# Bucket credentials
S3_BUCKET = {{ op://Account/Cloudflare R2 LFS Read Write Token/bucket }}
S3_ENDPOINT = {{ op://Account/Cloudflare R2 LFS Read Write Token/endpoint }}
S3_READ_KEY_ID = {{ op://Account/Cloudflare R2 LFS Read Token/s3 access key id }}
S3_READ_SECRET_KEY = {{ op://Account/Cloudflare R2 LFS Read Token/s3 secret access key }}
S3_READ_WRITE_KEY_ID = {{ op://Account/Cloudflare R2 LFS Read Write Token/s3 access key id }}
S3_READ_WRITE_SECRET_KEY = {{ op://Account/Cloudflare R2 LFS Read Write Token/s3 secret access key }}
