# Generated into .env by `pnpm run init` (op inject)
# Uploaded as Worker secrets on `pnpm run deploy` via `wrangler deploy --secrets-file .env`
# EVERY key here becomes a Worker secret, and secrets are always strings —
# non-secret / typed config belongs in "vars" in wrangler.jsonc instead

# Bucket credentials
# The read-only key signs download URLs and HEAD checks (least privilege),
# the read/write key only signs upload URLs
R2_S3_BUCKET = {{ op://Personal/Cloudflare R2 Kitschpatrol LFS Read Write Token/bucket }}
R2_S3_ENDPOINT = {{ op://Personal/Cloudflare R2 Kitschpatrol LFS Read Write Token/endpoint }}
# TODO: Point the read slots at a real read-only token before production
R2_S3_READ_KEY_ID = {{ op://Personal/Cloudflare R2 Kitschpatrol LFS Read Write Token/s3 access key id }}
R2_S3_READ_SECRET_KEY = {{ op://Personal/Cloudflare R2 Kitschpatrol LFS Read Write Token/s3 secret access key }}
R2_S3_READ_WRITE_KEY_ID = {{ op://Personal/Cloudflare R2 Kitschpatrol LFS Read Write Token/s3 access key id }}
R2_S3_READ_WRITE_SECRET_KEY = {{ op://Personal/Cloudflare R2 Kitschpatrol LFS Read Write Token/s3 secret access key }}
