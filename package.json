{
	"name": "git-lfsaver",
	"version": "1.0.1",
	"private": true,
	"description": "Serverless Git LFS server for Cloudflare Workers + R2 with seamless GitHub auth.",
	"keywords": [
		"git",
		"lfs",
		"git-lfs",
		"github",
		"cloudflare",
		"workers",
		"r2",
		"s3"
	],
	"homepage": "https://github.com/kitschpatrol/git-lfsaver",
	"bugs": "https://github.com/kitschpatrol/git-lfsaver/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/git-lfsaver.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"scripts": {
		"audit": "node scripts/audit.ts",
		"build": "node scripts/version.ts",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"deploy": "pnpm run build && wrangler deploy --secrets-file .env",
		"dev": "wrangler types && wrangler dev",
		"fix": "ksc fix --skip repo",
		"init": "op inject -i .template.env -o .env",
		"lint": "ksc lint --skip repo",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp -c 'Release: %s'",
		"test": "vitest run",
		"token": "node scripts/token.ts"
	},
	"dependencies": {
		"@octokit/rest": "^22.0.1",
		"aws4fetch": "^1.0.20",
		"jose": "6.2.12",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.3.6",
		"@kitschpatrol/shared-config": "^8.12.1",
		"bumpp": "^12.3.0",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.147.0"
	},
	"packageManager": "pnpm@12.9.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.16.0"
		}
	}
}
